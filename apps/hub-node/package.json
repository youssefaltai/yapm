{
  "name": "@life-os/hub-node",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runs the hub on Node.js with a SQLite file, for any VPS or Docker host.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@libsql/client": "0.18.0",
    "@life-os/core": "workspace:*",
    "@life-os/schema": "workspace:*",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
