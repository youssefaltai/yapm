{
  "name": "@life-os/runner",
  "version": "0.2.0",
  "type": "module",
  "description": "Runs your company's agents on this machine with the Claude Agent SDK.",
  "repository": {
    "type": "git",
    "url": "https://github.com/youssefaltai/ai-life-os",
    "directory": "apps/runner"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "life-os-runner": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.293",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "@life-os/core": "workspace:*",
    "@life-os/hub-node": "workspace:*",
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
