{
  "name": "@yapm/runner",
  "version": "0.6.0",
  "type": "module",
  "description": "Runs your company's agents on this machine with the Claude Agent SDK or OpenCode.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/youssefaltai/yapm",
    "directory": "apps/runner"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "yapm-runner": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.293",
    "@opencode-ai/sdk": "1.19.0"
  },
  "devDependencies": {
    "@yapm/core": "workspace:*",
    "@yapm/hub-node": "workspace:*",
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
